# Server
NODE_ENV=development
PORT=3001

# Demo mode: in-memory SQLite reseeded on every start, bots fill matches,
# payments and email switched off. Leave unset for a real deployment.
DEMO_MODE=
# Seconds a lone player waits before bots fill the match (0 = never; demo default 3)
BOT_FILL_SECONDS=
# Round length in seconds (default 120)
ROUND_SECONDS=

# Database (ignored in demo mode)
DATABASE_URL=postgresql://steamblast:password@localhost:5432/steamblast_dev

# Redis (ignored in demo mode)
REDIS_URL=redis://localhost:6379

# JWT (required in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@steamblastgame.com

# Frontend URLs (for CORS when the client and admin are served separately)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Premium price (HKD cents)
PREMIUM_PRICE_HKD=2000
